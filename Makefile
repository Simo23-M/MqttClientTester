mqtt_tls_client_qml.app/Contents/Info.plist: 
	@test -d mqtt_tls_client_qml.app/Contents || mkdir -p mqtt_tls_client_qml.app/Contents
	@$(DEL_FILE) mqtt_tls_client_qml.app/Contents/Info.plist
	@plutil -convert xml1 -o - ../../Qt/6.8.0/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,simo.mqtt-tls-client-qml,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},simo.mqtt-tls-client-qml,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},12.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,mqtt_tls_client_qml,g" -e "s,@LIBRARY@,mqtt_tls_client_qml,g" -e "s,\$${EXECUTABLE_NAME},mqtt_tls_client_qml,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >mqtt_tls_client_qml.app/Contents/Info.plist

